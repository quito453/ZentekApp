# Copy to .env.local and fill in from Supabase: Project Settings > API.
# The anon key is safe in the browser: row-level security decides what each login can see.
# Never put the service_role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Technicians sign in with a username. Supabase needs an email, so each username becomes
# <username>@<this domain>. Use a subdomain you own with no mailbox (no email is ever sent there).
# Must match LOGIN_EMAIL_DOMAIN in the Edge Function secrets.
VITE_LOGIN_EMAIL_DOMAIN=users.yourdomain.com
