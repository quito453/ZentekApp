# Copy to .env.local and fill in from Supabase: Project Settings > API.
# The anon key is safe in the browser: row-level security decides what each login can see.
# Never put the service_role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Same domain as the technician app and the Edge Functions' LOGIN_EMAIL_DOMAIN secret.
VITE_LOGIN_EMAIL_DOMAIN=users.yourdomain.com
