# Copy to .env.local and fill in from Supabase: Project Settings > API.
# The anon key is safe in the browser: row-level security decides what each login can see.
# Never put the service_role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Same domain as the technician app and the Edge Functions' LOGIN_EMAIL_DOMAIN secret.
VITE_LOGIN_EMAIL_DOMAIN=users.yourdomain.com
# Map tiles for the Routes screen. Defaults to OpenStreetMap, which is fine for trying it out; for daily
# use pick a tile provider (MapTiler, Stadia, Thunderforest…) and put its URL here, key included.
# VITE_MAP_TILES=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=© OpenStreetMap contributors
# Google Maps for address search (Places API (New)) and the maps (Maps JavaScript API). Browser key:
# restrict it in Google Cloud to your site's address. Without it, addresses are typed and maps use OpenStreetMap.
VITE_GOOGLE_MAPS_KEY=
# Optional: your own map id from Google Cloud (DEMO_MAP_ID is used if empty).
VITE_GOOGLE_MAP_ID=
# Optional: "owner" opens on Finance, "dispatch" hides Finance. Empty = both, by role.
VITE_APP_FOCUS=
